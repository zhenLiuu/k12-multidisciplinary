{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "record.schema.json",
  "title": "K12 Data v0.1.0 Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source_id",
    "source_file",
    "split",
    "question_type",
    "subject",
    "language",
    "question",
    "options",
    "answer",
    "explanation",
    "images",
    "table",
    "sub_questions",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^k12_[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_file": {
      "enum": [
        "all_disciplines_with_idx",
        "math_non_mc",
        "merge_multiple_choice",
        "final_data_v8.2"
      ]
    },
    "split": {
      "enum": [
        "raw",
        "test"
      ]
    },
    "question_type": {
      "enum": [
        "multiple_choice",
        "non_multiple_choice"
      ]
    },
    "subject": {
      "enum": [
        "math",
        "physics",
        "biology",
        "geography",
        "chemistry"
      ]
    },
    "language": {
      "enum": [
        "zh",
        "en"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "text"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[A-H]$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "answer": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explanation": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "caption",
          "part_of"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^images/[0-9a-f]{2}/[0-9a-f]{64}\\.[A-Za-z0-9]+$"
          },
          "caption": {
            "type": "string"
          },
          "part_of": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "table": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caption",
          "path",
          "part_of"
        ],
        "properties": {
          "caption": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "part_of": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sub_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_index": {
          "type": "integer"
        },
        "source_question_type": {
          "type": "string"
        },
        "cot": {
          "type": "boolean"
        },
        "resource": {
          "type": "string"
        },
        "tag": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_explanation_parts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "string"
        }
      }
    }
  }
}
